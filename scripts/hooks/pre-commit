#!/usr/bin/env bash
set -euo pipefail

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
git fetch origin "$BRANCH" --quiet 2>/dev/null || exit 0

BEHIND="$(git rev-list --count "HEAD..origin/$BRANCH" 2>/dev/null || echo 0)"

if [ "$BEHIND" -gt 0 ]; then
  echo ""
  echo "❌ Commit bloqueado: existem $BEHIND commit(s) novo(s) em origin/$BRANCH."
  echo ""
  echo "Para trazer as alterações antes de commitar:"
  echo "  git pull --rebase"
  echo ""
  echo "Se houver conflitos:"
  echo "  1. Veja os arquivos em conflito:  git diff --name-only --diff-filter=U"
  echo "  2. Resolva os marcadores <<<<<<< ======= >>>>>>> nos arquivos"
  echo "  3. Marque como resolvido:        git add <arquivo>"
  echo "  4. Continue o rebase:            git rebase --continue"
  echo ""
  exit 1
fi
