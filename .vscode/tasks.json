{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git Auto Pull (on open)",
      "type": "shell",
      "command": "git pull --ff-only",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Git Auto Sync Watch",
      "type": "shell",
      "command": "./scripts/auto-sync.sh",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
